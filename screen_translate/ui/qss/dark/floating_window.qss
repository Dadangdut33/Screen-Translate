DetachedWindow, CaptureWindow, MaskWindow {
    background-color: rgba(39, 39, 39, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
}

DetachedWindow BodyLabel,
CaptureWindow QLabel,
MaskWindow BodyLabel {
    color: rgb(244, 244, 244);
    font: 13px --FontFamilies;
}
