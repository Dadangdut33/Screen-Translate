QWidget#SettingsPage {
    background-color: rgb(249, 249, 249);
    color: rgb(32, 32, 32);
}

QWidget#SettingsPage QGroupBox {
    background-color: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 8px;
    font: 600 13px --FontFamilies;
}

QWidget#SettingsPage QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: rgb(48, 48, 48);
}

QWidget#SettingsPage QLabel,
QWidget#SettingsPage BodyLabel,
QWidget#SettingsPage QCheckBox,
QWidget#SettingsPage QRadioButton {
    color: rgb(32, 32, 32);
}
