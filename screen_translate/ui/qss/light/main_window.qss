MainWindow {
    background-color: rgb(249, 249, 249);
    color: rgb(28, 28, 28);
}

MainWindow QAbstractScrollArea#ContentScrollArea,
MainWindow QWidget#ContentScrollViewport,
MainWindow QWidget#ContentScrollContainer {
    background-color: transparent;
    border: none;
}

MainWindow QWidget#MainContentShell {
    background-color: transparent;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

MainWindow QWidget#MainStackedWidget {
    background-color: rgba(249, 249, 249, 0.98);
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

MainWindow QWidget,
MainWindow QLabel,
MainWindow QCheckBox,
MainWindow QRadioButton,
MainWindow QGroupBox,
MainWindow QLineEdit,
MainWindow QPlainTextEdit,
MainWindow QComboBox,
MainWindow QSpinBox,
MainWindow QAbstractItemView,
MainWindow QHeaderView::section,
MainWindow QPushButton,
MainWindow QToolButton {
    color: rgb(28, 28, 28);
}

MainWindow QWidget:disabled,
MainWindow QLabel:disabled,
MainWindow QCheckBox:disabled,
MainWindow QRadioButton:disabled,
MainWindow QGroupBox:disabled,
MainWindow QLineEdit:disabled,
MainWindow QPlainTextEdit:disabled,
MainWindow QComboBox:disabled,
MainWindow QSpinBox:disabled,
MainWindow QAbstractItemView:disabled,
MainWindow QPushButton:disabled,
MainWindow QToolButton:disabled {
    color: rgba(28, 28, 28, 0.42);
}

MainWindow QToolBar {
    background-color: transparent;
    border: none;
    spacing: 6px;
    padding: 8px 10px 4px 10px;
}

MainWindow QTextEdit {
    background-color: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
    color: rgb(28, 28, 28);
    font: 14px --FontFamilies;
    padding: 10px;
}

MainWindow QStatusBar {
    background: transparent;
    color: rgb(28, 28, 28);
}

MainWindow QToolButton#WorkspaceActionButton {
    background-color: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.10);
    border-radius: 10px;
}

MainWindow QToolButton#WorkspaceActionButton:hover {
    background-color: rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.14);
}

MainWindow QToolButton#WorkspaceActionButton:pressed {
    background-color: rgba(0, 0, 0, 0.10);
}

MainWindow QToolButton#WorkspaceActionButton:disabled {
    background-color: rgba(0, 0, 0, 0.015);
    border: 1px dashed rgba(0, 0, 0, 0.10);
    color: rgba(28, 28, 28, 0.34);
}

#AboutPage {
    background-color: transparent;
}

#AboutHeroCard, #AboutInfoCard {
    background-color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
}

#PageHeaderCard {
    background-color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
}

#ToolWindowCard {
    background-color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
}

#OCRImageCard {
    background-color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
}

#OCRImagePreview {
    background-color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
}

#OCRImageTag {
    font: 600 14px --FontFamilies;
}

#AboutVersion {
    color: rgba(0, 0, 0, 0.62);
    font: 15px --FontFamilies;
}

#AboutSectionTitle {
    font: 600 18px --FontFamilies;
}

#PageHeaderSubtitle {
    color: rgba(0, 0, 0, 0.62);
}

#AboutUpdateStatus {
    color: rgba(0, 0, 0, 0.62);
}
